# ============================================================
# Supabase (REQUIRED)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ============================================================
# Site URL (RECOMMENDED)
# Used to assemble absolute URLs on the server.
# Defaults to http://localhost:3000/ when unset.
# ============================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# Google Analytics (OPTIONAL)
# Only loaded in production builds.
# ============================================================
NEXT_PUBLIC_GA_ID=

# ============================================================
# Mock data mode (OPTIONAL)
# When set to "true", uses mock session/data flows.
# ============================================================
NEXT_PUBLIC_USE_MOCK_DATA=false

# ============================================================
# Gemini model (OPTIONAL)
# Defaults to gemini-2.5-flash when unset.
# ============================================================
GEMINI_MODEL=gemini-2.5-flash
